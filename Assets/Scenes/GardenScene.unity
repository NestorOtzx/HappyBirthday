    - target: {fileID: 8345323138948470222, guid: a3399ae14fea217428bb91ba1d51c785, type: 3}
      propertyPath: m_Name
      value: MessagePanel
      objectReference: {fileID: 0}
    - target: {fileID: 9170568926111105534, guid: a3399ae14fea217428bb91ba1d51c785, type: 3}
      propertyPath: m_text
      value: "Me alegra que existas y que haya podido coincidir contigo. \nGracias
        por restarle un poco de realidad a mis d\xEDas con cada conversaci\xF3n.
        \nMe alegra saber que tendremos muchos m\xE1s momentos para charlar. \nMe
        gusta escucharte hablar.\nGracias por los momentos de silencio, donde no
        es necesario hablar para entendernos.\nMe alegra encontrar tanta paz en ti.\nMe
        gusta cada segundo que estamos juntos.\nGracias por dejarme pasar las noches
        a tu lado. \nMe alegra que el mundo se quede quieto cada vez que est\xE1s
        sobre mi cama y yo entre tus brazos. \nMe gusta dormir sintiendo el ritmo
        de tu pecho.\nGracias por cada sonrisa que hemos compartido. \nMe alegra
        que sin propon\xE9rtelo, seas mi mejor motivo para sonre\xEDr. \nMe gusta
        verte reir y reir contigo.\nGracias por todo lo que eres y haces.\nMe alegra
        ser alguien a quien quieres.\nMe gusta todo este cari\xF1o que te traigo.\n"
      objectReference: {fileID: 0}
