  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Me alegra que existas y que haya podido coincidir contigo. \r\nGracias
    por restarle un poco de realidad a mis d\xEDas con cada conversaci\xF3n. \r\nMe
    alegra saber que tendremos muchos m\xE1s momentos para charlar. \r\nMe gusta
    escucharte hablar.\r\nGracias por los momentos de silencio, donde no es necesario
    hablar para entendernos.\r\nMe alegra encontrar tanta paz en ti.\r\nMe gusta
    cada segundo que estamos juntos.\r\nGracias por dejarme pasar las noches a tu
    lado. \r\nMe alegra que el mundo se quede quieto cada vez que est\xE1s sobre
    mi cama y yo entre tus brazos. \r\nMe gusta dormir sintiendo el ritmo de tu pecho.\r\nGracias
    por cada sonrisa que hemos compartido. \r\nMe alegra que sin propon\xE9rtelo,
    seas mi mejor motivo para sonre\xEDr. \r\nMe gusta verte reir y reir contigo.\r\nGracias
    por todo lo que eres y haces.\r\nMe alegra ser alguien a quien quieres.\r\nMe
    gusta todo este cari\xF1o que te traigo.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7f8a98d3125e60348be1c76fbe53801d, type: 2}
  m_sharedMaterial: {fileID: -2215105364599238252, guid: 7f8a98d3125e60348be1c76fbe53801d, type: 2}
